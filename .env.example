# Radarr Plutonium Cloud Integration Environment Variables

# API Configuration
RADARR_API_KEY=your_api_key_here
RADARR_URL=http://localhost:7878

# Plutonium Cloud Integration
PLUTONIUM_API_KEY=
PLUTONIUM_SESSION_TOKEN=
PLUTONIUM_HOST=plutonium.local

# Database (optional overrides)
RADARR_DB_PATH=/data/radarr.db
